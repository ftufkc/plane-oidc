APP_DOMAIN=plane.example:3307
WEB_URL=http://plane.example:3307
CORS_ALLOWED_ORIGINS=http://plane.example:3307
LISTEN_HTTP_PORT=3307
LISTEN_HTTPS_PORT=3443
SITE_ADDRESS=:80
CERT_EMAIL=
CERT_ACME_CA=
CERT_ACME_DNS=
SECRET_KEY=replace-with-a-unique-random-secret
LIVE_SERVER_SECRET_KEY=replace-with-a-unique-random-secret
POSTGRES_PASSWORD=replace-with-a-unique-random-secret
AWS_ACCESS_KEY_ID=plane-minio
AWS_SECRET_ACCESS_KEY=replace-with-a-unique-random-secret
